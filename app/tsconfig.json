{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // @build-north/agents imports its own files with a .ts extension, and so does this app, so the
    // session logic also runs under Node for the tests (`npm test`).
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
