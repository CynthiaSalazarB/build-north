# Copy to .env and fill in. Never commit .env.
# Ask in Discord for the shared dev values.

# ---------- api (server only: these never reach the app) ----------
PORT=3000
ANTHROPIC_API_KEY=
# One model for every agent until we measure latency on Oct 20
AGENT_MODEL=claude-opus-5-5

SURREAL_URL=            # wss://<instance>.surreal.cloud
SURREAL_NAMESPACE=build_north
SURREAL_DATABASE=dev
SURREAL_USER=
SURREAL_PASS=
SURREAL_AUTH_LEVEL=root # root | namespace | database: the level SURREAL_USER was created at

DEV_KEY=                # until Clerk lands (#23): x-dev-user only counts with x-dev-key equal to this; ask Leo
CLERK_JWT_KEY=          # Clerk dashboard, API keys, Show JWT public key: the PEM on one line, with \n between its lines
CORS_ORIGIN=http://localhost:8081   # comma-separated: add the deployed web build URL when it exists

# ---------- app: copy these into app/.env (Expo reads that folder's .env). EXPO_PUBLIC_* is bundled into the app: nothing secret here ----------
EXPO_PUBLIC_API_URL=http://localhost:3000   # leave unset for demo mode (replays the session-1 fixture)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_DEV_USER=   # until Clerk (#22): the x-dev-user name the app sends
EXPO_PUBLIC_DEV_KEY=    # local dev only, the same DEV_KEY; never set it for the deployed web build
