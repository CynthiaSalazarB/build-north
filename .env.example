# Copy to .env and fill in. Never commit .env.
# Ask in Discord for the shared dev values.

# ---------- api (server only: these never reach the app) ----------
PORT=3000
ANTHROPIC_API_KEY=
# One model for every agent until we measure latency on Oct 20
AGENT_MODEL=claude-opus-5-5

SURREAL_URL=            # wss://<instance>.surreal.cloud
SURREAL_NAMESPACE=build_north
SURREAL_DATABASE=dev
SURREAL_USER=
SURREAL_PASS=

CLERK_SECRET_KEY=       # from Oct 21
CORS_ORIGIN=http://localhost:8081

# ---------- app (EXPO_PUBLIC_* is bundled into the app: nothing secret here) ----------
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
